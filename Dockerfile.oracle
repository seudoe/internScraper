# ─── iFind Scraper API — self-hosted image (Oracle Always Free Arm A1, also runs on amd64) ───
#
# Multi-arch: Debian's chromium + chromium-driver exist for arm64 and amd64 (Google Chrome has no
# Linux arm64 build). The original Dockerfile (Render / Hugging Face) is unchanged.
#
# webdriver-manager is uninstalled on purpose: the scrapers fall back to plain
# webdriver.Chrome(options=...) when it is missing, and Selenium finds /usr/bin/chromedriver on PATH.
#
#   docker build -f Dockerfile.oracle -t ifind-scraper .

FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium chromium-driver fonts-liberation ca-certificates curl tini \
 && ln -s /usr/bin/chromium /usr/local/bin/google-chrome \
 && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user PATH=/home/user/.local/bin:$PATH PYTHONUNBUFFERED=1
WORKDIR $HOME/app

COPY --chown=user requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt \
 && pip uninstall -y webdriver-manager

COPY --chown=user . $HOME/app
RUN mkdir -p $HOME/app/data

EXPOSE 7860
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s \
  CMD curl -fs http://localhost:${PORT:-7860}/health || exit 1

ENTRYPOINT ["tini", "--"]
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT:-7860} --workers 1"]
